# ==========================================
# BLOG FILIPEM2 - ARQUIVO DE CONFIGURAÇÃO (.env)
# ==========================================

# Ambiente de Execução (development ou production)
NODE_ENV=production

# Porta do Servidor Web
PORT=3000

# Chave Secreta para Assinatura de Tokens JWT (Altere para uma chave longa e aleatória em produção!)
# Gere uma chave com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=filipem2_super_secure_jwt_secret_key_2026_change_in_production_!

# URL Base Oficial do Portal (utilizada para links canônicos, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://blogfilipem2.com.br

# Credenciais Iniciais de Administrador
# E-mail padrão: admin@filipem2.com
# Senha padrão: admin123456 (Altere no primeiro login em /admin/usuarios)
